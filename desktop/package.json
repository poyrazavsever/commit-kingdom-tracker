{
  "name": "tudi-desktop",
  "productName": "Commit Kingdom Desktop",
  "description": "Signs this computer in to Commit Kingdom, sets up tudi-cli and shows today's coding.",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "main": "out/main/main.js",
  "scripts": {
    "postinstall": "install-electron --no",
    "build": "tsc -p .",
    "build:extension": "npm --prefix ../vscode run package",
    "build:cli": "node scripts/build-cli.mjs",
    "build:jetbrains": "node scripts/build-jetbrains.mjs",
    "start": "npm run build:extension && tsc -p . && electron .",
    "test": "tsc -p . && node --test out/test/signIn.test.js out/test/setup.test.js out/test/queue.test.js out/test/jetbrains.test.js",
    "dist": "npm run build:extension && tsc -p . && electron-builder",
    "dist:dir": "npm run build:extension && tsc -p . && electron-builder --dir"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "author": {
    "name": "Commit Kingdom",
    "email": "merhaba@commitkingdom.com"
  },
  "homepage": "https://commitkingdom.com/tracker",
  "repository": {
    "type": "git",
    "url": "https://github.com/poyrazavsever/commit-kingdom-tracker"
  },
  "build": {
    "appId": "com.tudidaily.desktop",
    "productName": "Commit Kingdom Desktop",
    "copyright": "Copyright (c) 2026 Commit Kingdom",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "!out/test/**",
      "static/**",
      "assets/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../vscode/tudi-tracker.vsix",
        "to": "extensions/tudi-tracker.vsix"
      },
      {
        "from": "resources/extensions",
        "to": "extensions",
        "filter": [
          "*.zip"
        ]
      },
      {
        "from": "resources/bin/${platform}-${arch}",
        "to": "bin/${platform}-${arch}"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "TudiDesktop-Setup.${ext}",
      "shortcutName": "Commit Kingdom Desktop",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "artifactName": "TudiDesktop-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "poyrazavsever",
        "repo": "commit-kingdom-tracker",
        "tagNamePrefix": "desktop-v",
        "releaseType": "release"
      }
    ]
  }
}
